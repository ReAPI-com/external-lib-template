{
  "compilationOptions": {
    "followSymlinks": true,
    "preferredConfigPath": "./tsconfig.json"
  },
  "entries": [
    {
      "filePath": "./src/_support/build.ts",
      "outFile": "./dist/bundle.d.ts",
      "libraries": {
        "inlinedLibraries": []
      },
      "output": {
        "inlineDeclareGlobals": true,
        "inlineDeclareExternals": false,
        "exportReferencedTypes": false,
        "noBanner": true
      }
    }
  ]
}